+def _rmtree_retry(path: Path, attempts: int = 6) -> None:
+    """Local patch: on Windows, sync clients and indexers briefly lock folders, so a delete
+    can fail with 'Access is denied'; retry instead of failing the whole stage."""
+    import os
+    import stat
+    import time
+
+    def _clear_readonly(func, p, _exc):
+        os.chmod(p, stat.S_IWRITE)
+        func(p)
+
+    for i in range(attempts):
+        try:
+            shutil.rmtree(path, onexc=_clear_readonly)
+            return
+        except PermissionError:
+            if i == attempts - 1:
+                raise
+            time.sleep(1 + i)
+
+
