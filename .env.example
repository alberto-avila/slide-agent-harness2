# Copy to .env and fill in. .env is git-ignored; never commit your key.
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible endpoint instead of api.openai.com
OPENAI_BASE_URL=

# Judge settings (separate from the slide agent's model)
JUDGE_PROVIDER=openai
JUDGE_MODEL=gpt-6-astra

# Improver settings (the model that proposes harness edits). Defaults to local Ollama/gemma4.
IMPROVER_PROVIDER=ollama
# For an API improver: IMPROVER_PROVIDER=openai and IMPROVER_MODEL=gpt-6-luna (or gpt-6.1-sol)
IMPROVER_MODEL=
